        <mxCell id="node_homotopy_metric" value="Unified Homotopy Metric&lt;br&gt;$$ \mathcal{S}_{\text{H-WIoU}} = [\text{IoU}]^{\gamma(s)} \cdot e^{-(1-\gamma(s))\mathcal{D}_{\mathcal{W}}^2} $$" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
