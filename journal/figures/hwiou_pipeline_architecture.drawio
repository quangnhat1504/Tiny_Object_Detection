        <mxCell id="BhOBRXsO3C4MXNqMHLrS-71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;strokeWidth=1;" value="&lt;b&gt;Classification Head&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#92400E&quot; style=&quot;font-size: 10px;&quot;&gt;$$\mathcal{L}_{\mathrm{cls}} = -\sum y_c \log \hat{p}_c$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="135" x="930" y="100" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.2;" value="&lt;b&gt;Bounded Box Head&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 10px;&quot;&gt;$$\mathcal{L}_{\mathrm{H\text{-}WIoU}} = 1 - \mathcal{S}_{\mathrm{H\text{-}WIoU}}$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="135" x="930" y="175" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" value="&lt;b&gt;&lt;font color=&quot;#991B1B&quot;&gt;Active Gradient Optimization:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size: 11px;&quot;&gt;$$\|\nabla_\theta \mathcal{L}_{\mathrm{H\text{-}WIoU}}\| = \mathcal{O}(1) &gt; 0\ (\mathrm{when\ IoU} \equiv 0)$$&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7C3AED&quot; style=&quot;font-size: 10px;&quot;&gt;$$\lim_{s \to 0}(1-\gamma(s)) = 1.0 \longrightarrow \mathrm{Guaranteed\ Convergence}$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="775" y="255" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#FDA4AF;strokeWidth=1.2;arcSize=4;" value="" vertex="1">
