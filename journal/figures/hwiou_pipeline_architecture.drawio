        <mxCell id="BhOBRXsO3C4MXNqMHLrS-75" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;b&gt;&lt;font color=&quot;#9F1239&quot; style=&quot;font-size: 13px;&quot;&gt;Final Detections&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BE123C&quot; style=&quot;font-size: 11px;&quot;&gt;Sub-Pixel Accurate Boundary&lt;/font&gt;" vertex="1">
          <mxGeometry height="35" width="200" x="1115" y="50" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=12;" value="&lt;b&gt;&lt;font color=&quot;#15803D&quot;&gt;■ Ground Truth Box&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;■ H-WIoU (IoU = 0.91)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;■ Baseline (IoU = 0.22)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;• +2.54% AP0.50 Boost&lt;br&gt;• 5.2× Anchor Survival&lt;br&gt;• Zero Gradient Vanishing&lt;/font&gt;" vertex="1">
          <mxGeometry height="265" width="180" x="1125" y="100" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-77" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=1.6;arcSize=4;" value="" vertex="1">
          <mxGeometry height="243" width="600" x="475" y="434" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-78" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;b&gt;&lt;font color=&quot;#4C1D95&quot; style=&quot;font-size: 14px;&quot;&gt;Mathematical Scale-Homotopy Engine (Theorem 1)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="25" width="560" x="500" y="445" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-79" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1;" value="&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size: 13px;&quot;&gt;$$\mathcal{S}_{\mathrm{H\text{-}WIoU}}(A, B) = \gamma(s_B)\,\mathrm{IoU}(A, B) + (1 - \gamma(s_B))\,\exp\left(-\mathcal{D}_{\mathcal{W}}^2(A, B)\right)$$&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7C3AED&quot; style=&quot;font-size: 11px;&quot;&gt;$$\mathrm{where}\quad \gamma(s) = \frac{s^2}{s^2 + \sigma_0^2}\in(0, 1)\quad (\sigma_0 \approx 8.0\mathrm{px}\ \mathrm{is\ the\ characteristic\ microscopic\ scale})$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="98" width="560" x="495" y="488" as="geometry" />
        </mxCell>
