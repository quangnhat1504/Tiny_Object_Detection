        <mxCell id="BhOBRXsO3C4MXNqMHLrS-127" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;b&gt;&lt;font color=&quot;#92400E&quot; style=&quot;font-size: 15px;&quot;&gt;Mathematical Scale-Homotopy Engine (Theorem 1)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="25" width="530" x="1276" y="1763" as="geometry" />
        </mxCell>
        <mxCell id="BhOBRXsO3C4MXNqMHLrS-128" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;" value="&lt;font color=&quot;#B45309&quot; style=&quot;font-size: 14px;&quot;&gt;$$\mathcal{S}_{\mathrm{H\text{-}WIoU}}(A, B) = \gamma(s_B)\,\mathrm{IoU}(A, B) + (1 - \gamma(s_B))\,\exp\left(-\mathcal{D}_{\mathcal{W}}^2(A, B)\right)$$&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#92400E&quot; style=&quot;font-size: 12px;&quot;&gt;$$\mathrm{where}\quad \gamma(s) = \frac{s^2}{s^2 + \sigma_0^2}\in(0, 1)\quad (\sigma_0 \approx 8.0\mathrm{px}\ \mathrm{is\ the\ characteristic\ microscopic\ scale})$$&lt;/font&gt;" vertex="1">
