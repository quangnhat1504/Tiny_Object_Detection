        <mxCell id="BhOBRXsO3C4MXNqMHLrS-66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1;" value="&lt;b&gt;Dynamic Cost Matrix Matching&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size: 12px;&quot;&gt;$$\mathbf{S}_{ij} = \mathcal{S}_{\mathrm{H\text{-}WIoU}}(A_i, G_j)$$&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size: 11px;&quot;&gt;Top-k Positive Anchor Selection&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot; style=&quot;font-size: 10px;&quot;&gt;Anchor Survival: 18.2% → &lt;b&gt;94.6% (5.2×)&lt;/b&gt;&lt;/font&gt;" vertex="1">
