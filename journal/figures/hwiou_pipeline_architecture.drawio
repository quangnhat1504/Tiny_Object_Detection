        <mxCell id="BhOBRXsO3C4MXNqMHLrS-70" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1;" value="&lt;b&gt;RoIAlign (7 × 7 × 256)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 10px;&quot;&gt;Bilinear Fractional Alignment&lt;br&gt;Zero Quantization Loss&lt;/font&gt;" vertex="1">
