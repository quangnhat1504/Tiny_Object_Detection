        <!-- Disjoint Label -->
        <mxCell id="disjoint_lbl" value="&lt;font color=&quot;#DC2626&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Disjoint (Offset &amp;gt; 2 px)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="155" y="150" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- Mathematical Box (a) -->
        <mxCell id="math_a" value="&lt;b&gt;Discontinuous Gradient Collapse:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size: 12px;&quot;&gt;$$\mathrm{IoU}(A, G) \equiv 0$$&lt;br&gt;$$\|\nabla_\theta \mathcal{L}_{\mathrm{IoU}}\| \equiv \mathbf{0}\quad (\mathrm{Vanishing\ Gradient})$$&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size: 10px;&quot;&gt;• Indicator function has zero derivative under disjoint sets.&lt;br&gt;• Severe anchor starvation during proposal assignment.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=0.8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="240" width="310" height="175" as="geometry" />
        </mxCell>

        <!-- ============================================================================== -->
        <!-- PANEL (b): WASSERSTEIN OPTIMAL TRANSPORT SPACE [x: 410, y: 50, w: 340, h: 380] -->
        <!-- ============================================================================== -->
        <mxCell id="card_b" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="410" y="50" width="340" height="380" as="geometry" />
        </mxCell>
        <mxCell id="card_b_h" value="&lt;b&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size: 13px;&quot;&gt;(b) Optimal Transport Riemannian Space&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="320" height="25" as="geometry" />
