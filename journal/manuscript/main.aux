\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Theoretical Foundations of Homotopy Wasserstein-IoU (H-WIoU).} (a) The continuous scale homotopy parameter $\gamma (s) = \frac  {s^2}{s^2+\sigma _0^2}$ smoothly deforms between the microscopic regime ($s < 8\text  {px}$) and tiny/normal regime ($s \ge 8\text  {px}$). (b) Gradient norm asymptotics: standard IoU collapses to zero gradient under microscopic misalignments, whereas H-WIoU maintains bounded $\mathcal  {O}(1)$ gradient flow throughout training.}}{3}{}\protected@file@percent }
\newlabel{fig:homotopy_theory}{{1}{3}{}{figure.1}{}}
